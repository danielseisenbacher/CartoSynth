{
  "name": "CartoSynth",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "cartosynth",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
